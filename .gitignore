```gitignore
# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# Terraform variable files
*.tfvars
*.tfvars.json

# Exception: keep example variable files
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Sensitive/private files
*.pem
*.key
.env
.env.*

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Terraform plan files
*.tfplan
tfplan
plan.out
```